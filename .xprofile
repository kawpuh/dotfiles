#!/bin/env bash

if [[ $HOSTNAME == "toaster" ]]; then
	xrandr --output DP-0 --mode 1920x1080 --pos 0x0 --rotate normal --rate 144 --primary
	xrandr --output DVI-D-0 --right-of DP-0
fi

if [ -f "$HOME/.Xresources" ]; then
    xrdb -merge "$HOME/.Xresources"
fi

export PATH="$PATH:/home/ethan/bin:/home/ethan/.local/bin:/home/ethan/.emacs.d/bin:/home/ethan/.yarn/bin"
source $HOME/.config/local.zsh

# HiDPI scaling for Qt apps (Ark, lxqt-policykit-agent, ...) under a bare WM.
#
# xsettingsd (below) publishes Xft/DPI=96 plus Gdk/WindowScalingFactor=2. GTK
# multiplies those to get 192 effective DPI, but Qt has no equivalent of
# Gdk/WindowScalingFactor -- it reads Xft/DPI from XSETTINGS literally (which
# also outranks the Xft.dpi=192 in .Xresources) and lands on a 1.0 device pixel
# ratio. On campstove's 3840x2400 / 344mm panel (~283 real DPI) that renders
# Qt UIs at roughly a third of readable size.
#
# QT_SCALE_FACTOR is the Qt6 knob for this. QT_AUTO_SCREEN_SCALE_FACTOR and
# QT_ENABLE_HIGHDPI_SCALING used to live here, but both are Qt5-only and are
# silently ignored by Qt6, which is why they never had any effect on Ark.
#
# Set before the daemons below so Qt-based ones inherit it.
if [ "$(cat /etc/hostname)" = "campstove" ]; then
	export QT_SCALE_FACTOR=2
	# qtile runs as a systemd user service, which only sees the variables the
	# session .desktop Exec imports -- hand this one to the user manager too, or
	# apps launched from qtile never get it.
	systemctl --user import-environment QT_SCALE_FACTOR
fi

xset r rate 250 120
xset -b
no-accel
~/.fehbg
playerctld daemon
xsettingsd &
flameshot &
dunst &
copyq --start-server &
picom &
blueberry-tray &
lxqt-policykit-agent &
XDG_MENU_PREFIX=arch- kbuildsycoca6 --noincremental
